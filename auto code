-- ==========================================
-- SYSTÈME DE DÉTECTION INSTANTANÉE (LOGIQUE)
-- ==========================================
local autoMode = false
local scriptActive = true
local enEcriture = false -- garde-fou anti boucle infinie (écriture -> détection -> écriture...)
local connexions = {}

-- Trouve le frame CodeRedeem (contient la TextBox + le bouton Submit) via son vrai chemin.
-- FindFirstChild à chaque étape pour ne jamais planter si la fenêtre Codes n'est pas ouverte.
local function trouverFrameCodeRedeem()
    local codesGui = playerGui:FindFirstChild("Codes")
    if not codesGui then return nil end

    local inner = codesGui:FindFirstChild("Codes")
    if not inner then return nil end

    return inner:FindFirstChild("CodeRedeem")
end

local function trouverBoiteCode()
    local redeem = trouverFrameCodeRedeem()
    if not redeem then return nil end

    return redeem:FindFirstChild("TextBox")
end

-- Essaie d'abord de déclencher le bouton Submit (premier TextButton/ImageButton avec une
-- connexion Activated trouvé dans CodeRedeem). Si aucun n'a de connexion exploitable, on
-- retombe sur ReleaseFocus(true) : ça simule un appui sur Entrée et déclenche le FocusLost(true)
-- de la boîte, qui est souvent le vrai déclencheur de validation dans ce genre d'UI.
local function soumettreCode(boiteCode)
    local redeem = trouverFrameCodeRedeem()
    local soumis = false

    if redeem then
        for _, objet in ipairs(redeem:GetDescendants()) do
            if objet:IsA("TextButton") or objet:IsA("ImageButton") then
                local ok, connexionsBouton = pcall(getconnections, objet.Activated)
                if ok and connexionsBouton and #connexionsBouton > 0 then
                    connexionsBouton[1]:Fire()
                    soumis = true
                    break
                end
            end
        end
    else
        warn("[AutoCopier] playerGui.Codes.Codes.CodeRedeem introuvable, impossible de soumettre via un bouton")
    end

    if soumis then
        definirStatut("Soumission auto déclenchée (bouton)")
    elseif boiteCode then
        warn("[AutoCopier] Pas de bouton exploitable, tentative via ReleaseFocus(true) (simule Entrée)")
        boiteCode:ReleaseFocus(true)
        definirStatut("Soumission via Entrée (ReleaseFocus)")
    end
end

ecrireTexte = function(texte)
    if enEcriture or texte == "" then return end
    enEcriture = true

    local boiteCode = trouverBoiteCode()
    if boiteCode then
        boiteCode:CaptureFocus()
        boiteCode.Text = (boiteCode.Text or "") .. texte
        definirStatut('Écrit "' .. texte .. '"')

        if autoSubmitActif then
            compteurDepuisSoumission = compteurDepuisSoumission + 1
            if compteurDepuisSoumission >= seuilSoumission then
                task.wait(0.1) -- laisse le texte se propager avant de chercher/déclencher Submit
                soumettreCode(boiteCode)
                compteurDepuisSoumission = 0
            end
        end
    else
        -- Repli : si la fenêtre Codes n'est pas ouverte, on écrit dans la textbox actuellement focus
        definirStatut("Fenêtre Codes fermée, écriture en attente")
        local cibleEcriture = UserInputService:GetFocusedTextBox()
        if cibleEcriture then
            cibleEcriture.Text = cibleEcriture.Text .. texte
        end
    end

    pcall(function()
        if setclipboard then setclipboard(texte) end
    end)

    enEcriture = false
end

local function copierEtEcrire(texte)
    if not autoMode or texte == "" then return end
    ecrireTexte(texte)
    ajouterHistorique(texte)
end

-- Bascule partagée entre la touche rebindable et les boutons START/STOP
local function activerAutoMode(nouvelEtat)
    autoMode = nouvelEtat
    updateInterface(autoMode)

    if autoMode then
        for _, enfant in ipairs(topNotifContainer:GetDescendants()) do
            if (enfant:IsA("TextLabel") or enfant:IsA("TextBox")) and enfant.Text ~= "" then
                copierEtEcrire(enfant.Text)
                break
            end
        end
    end
end

startBtn.MouseButton1Click:Connect(function() activerAutoMode(true) end)
stopBtn.MouseButton1Click:Connect(function() activerAutoMode(false) end)

local function brancherDetecteur(objet)
    if objet:IsA("TextLabel") or objet:IsA("TextBox") then
        local connection = objet:GetPropertyChangedSignal("Text"):Connect(function()
            copierEtEcrire(objet.Text)
        end)
        table.insert(connexions, connection)

        if objet.Text ~= "" then
            copierEtEcrire(objet.Text)
        end
    end
end

for _, enfant in ipairs(topNotifContainer:GetDescendants()) do
    brancherDetecteur(enfant)
end
brancherDetecteur(topNotifContainer)

local childConnection = topNotifContainer.DescendantAdded:Connect(function(nouveauDescendant)
    brancherDetecteur(nouveauDescendant)
end)
table.insert(connexions, childConnection)

