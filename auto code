-- SYSTÈME DE DÉTECTION INSTANTANÉE (LOGIQUE)
-- ==========================================
local autoMode = false
local scriptActive = true
local enEcriture = false -- garde-fou anti boucle infinie (écriture -> détection -> écriture...)
local connexions = {}

-- Trouve le frame CodeRedeem (contient la TextBox + le bouton Submit) via son vrai chemin,
-- mis en cache pour éviter de refaire la chaîne de FindFirstChild à chaque appel.
-- FindFirstChild à chaque étape pour ne jamais planter si la fenêtre Codes n'est pas ouverte.
local redeemFrameCache = nil
local boiteCodeCache = nil

local function trouverFrameCodeRedeem()
    if redeemFrameCache and redeemFrameCache.Parent then
        return redeemFrameCache
    end

    local codesGui = playerGui:FindFirstChild("Codes")
    if not codesGui then return nil end

    local inner = codesGui:FindFirstChild("Codes")
    if not inner then return nil end

    local redeem = inner:FindFirstChild("CodeRedeem")
    redeemFrameCache = redeem
    return redeem
end

local function trouverBoiteCode()
    if boiteCodeCache and boiteCodeCache.Parent then
        return boiteCodeCache
    end

    local redeem = trouverFrameCodeRedeem()
    if not redeem then return nil end

    local boite = redeem:FindFirstChild("TextBox")
    boiteCodeCache = boite
    return boite
end

-- Beaucoup de jeux ferment la fenêtre Codes après un clic Submit (réussi ou pas).
-- La boîte peut donc rester techniquement valide (juste cachée) : on vérifie si la
-- fenêtre est visible, et sinon on la rouvre via le bouton "Codes" de la nav, comme
-- dans la source de référence.
local function fenetreCodesEstOuverte()
    local codesGui = playerGui:FindFirstChild("Codes")
    if not codesGui then return false end

    local inner = codesGui:FindFirstChild("Codes")
    if inner then return inner.Visible end

    return codesGui.Enabled
end

local function ouvrirFenetreCodes()
    local ok, err = pcall(function()
        local codesBtn = playerGui.LeftCenter.LeftCenter.Buttons.Codes
        local connexionsBtn = getconnections(codesBtn.Activated)
        print("[AutoCopier] Réouverture Codes : bouton trouvé, " .. #connexionsBtn .. " connexion(s)")
        for _, conn in ipairs(connexionsBtn) do
            conn:Fire()
        end
    end)
    if not ok then
        warn("[AutoCopier] Échec réouverture fenêtre Codes : " .. tostring(err))
    end
end

-- Cache le bouton Submit trouvé pour éviter de rescanner tout CodeRedeem à chaque
-- soumission : la toute première fois ça scanne, ensuite ça tire directement dessus.
local boutonSubmitCache = nil

local function tenterDeclencherBouton(bouton)
    local ok, connexionsBouton = pcall(getconnections, bouton.Activated)
    if ok and connexionsBouton and #connexionsBouton > 0 then
        connexionsBouton[1]:Fire()
        return true
    end
    return false
end

-- Essaie d'abord de déclencher le bouton Submit (mis en cache après la première réussite,
-- sinon premier TextButton/ImageButton avec une connexion Activated trouvé dans CodeRedeem).
-- Si aucun n'a de connexion exploitable, on retombe sur ReleaseFocus(true) : ça simule un
-- appui sur Entrée et déclenche le FocusLost(true) de la boîte, qui est souvent le vrai
-- déclencheur de validation dans ce genre d'UI.
local function soumettreCode(boiteCode)
    local soumis = false

    if boutonSubmitCache and boutonSubmitCache.Parent then
        soumis = tenterDeclencherBouton(boutonSubmitCache)
    end

    if not soumis then
        local redeem = trouverFrameCodeRedeem()
        if redeem then
            for _, objet in ipairs(redeem:GetDescendants()) do
                if objet:IsA("TextButton") or objet:IsA("ImageButton") then
                    if tenterDeclencherBouton(objet) then
                        boutonSubmitCache = objet
                        soumis = true
                        break
                    end
                end
            end
        else
            warn("[AutoCopier] playerGui.Codes.Codes.CodeRedeem introuvable, impossible de soumettre via un bouton")
        end
    end

    if soumis then
        definirStatut("Soumission auto déclenchée (bouton)")
    elseif boiteCode then
        warn("[AutoCopier] Pas de bouton exploitable, tentative via ReleaseFocus(true) (simule Entrée)")
        boiteCode:ReleaseFocus(true)
        definirStatut("Soumission via Entrée (ReleaseFocus)")
    end
end

-- Écrit un mot précis dans la boîte (remplace, pas d'accumulation). Rouvre d'abord la
-- fenêtre Codes si le jeu l'a fermée (souvent le cas juste après Submit).
local function ecrireMotDansBoite(texte)
    if not fenetreCodesEstOuverte() then
        ouvrirFenetreCodes()
    end

    local boiteCode = trouverBoiteCode()
    if boiteCode then
        boiteCode:CaptureFocus()
        boiteCode.Text = texte
        definirStatut('Écrit "' .. texte .. '"')
    else
        definirStatut("Fenêtre Codes fermée, écriture en attente")
        local cibleEcriture = UserInputService:GetFocusedTextBox()
        if cibleEcriture then
            cibleEcriture.Text = texte
        end
    end

    if setclipboard then pcall(setclipboard, texte) end

    return boiteCode
end

-- Utilisée par les clics manuels sur l'historique : chaque clic doit s'appliquer
-- immédiatement, sans verrou, même juste après une écriture automatique.
ecrireBrut = function(texte)
    if texte == "" then return nil end
    return ecrireMotDansBoite(texte)
end

-- Utilisée par la détection automatique : écrit le mot, retente Submit, puis remet
-- le DERNIER mot de l'historique (historique[1], la source de vérité affichée à
-- l'écran) dans la boîte tout de suite après, sans attendre le mot suivant.
ecrireTexte = function(texte)
    if enEcriture or texte == "" then return end
    enEcriture = true

    local boiteCode = ecrireMotDansBoite(texte)

    if boiteCode and autoSubmitActif then
        -- Zéro attente : appel direct, dans la même frame. Plus rapide mais risque de
        -- rater le Submit si le jeu n'a pas fini de traiter le texte (comportement
        -- "Deferred" des évènements Roblox) — repasser à task.defer(soumettreCode, boiteCode)
        -- si ça rate à nouveau avant le bon mot.
        soumettreCode(boiteCode)

        if historique[1] then
            ecrireMotDansBoite(historique[1])
        end
    end

    enEcriture = false
end

-- Log TOUJOURS dans l'historique (peu importe l'état du monitoring),
-- et ne copie/écrit dans la boîte que si le monitoring est actif.
local function surTexteDetecte(texte)
    if texte == "" then return end
    print('[AutoCopier] Texte détecté (brut) : "' .. texte .. '"')
    ajouterHistorique(texte)

    if autoMode then
        ecrireTexte(texte)
    end
end

-- Bascule partagée entre la touche rebindable et le bouton Monitoring.
-- N'attrape jamais un texte déjà présent au moment de l'activation : seuls les
-- textes qui apparaissent/changent APRÈS l'activation doivent être copiés.
local function activerAutoMode(nouvelEtat)
    autoMode = nouvelEtat
    updateInterface(autoMode)
end

monitoringBtn.MouseButton1Click:Connect(function() activerAutoMode(not autoMode) end)

local function brancherDetecteur(objet)
    if objet:IsA("TextLabel") or objet:IsA("TextBox") then
        local connection = objet:GetPropertyChangedSignal("Text"):Connect(function()
            surTexteDetecte(objet.Text)
        end)
        table.insert(connexions, connection)

        if objet.Text ~= "" then
            surTexteDetecte(objet.Text)
        end
    end
end

for _, enfant in ipairs(topNotifContainer:GetDescendants()) do
    brancherDetecteur(enfant)
end
brancherDetecteur(topNotifContainer)

local childConnection = topNotifContainer.DescendantAdded:Connect(function(nouveauDescendant)
    brancherDetecteur(nouveauDescendant)
end)
table.insert(connexions, childConnection)

