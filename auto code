-- ==========================================
-- SYSTÈME DE DÉTECTION INSTANTANÉE (LOGIQUE)
-- ==========================================
local autoMode = false
local scriptActive = true
local enEcriture = false -- garde-fou anti boucle infinie (écriture -> détection -> écriture...)
local connexions = {}

-- Trouve la boîte de saisie du code via son vrai chemin dans PlayerGui.Codes.
-- FindFirstChild à chaque étape pour ne jamais planter si la fenêtre Codes n'est pas ouverte.
local function trouverBoiteCode()
    local codesGui = playerGui:FindFirstChild("Codes")
    if not codesGui then return nil end

    local inner = codesGui:FindFirstChild("Codes")
    if not inner then return nil end

    local redeem = inner:FindFirstChild("CodeRedeem")
    if not redeem then return nil end

    return redeem:FindFirstChild("TextBox")
end

-- Cherche le bouton Submit n'importe où dans la fenêtre Codes (par nom ou par texte affiché).
-- GuiButton couvre à la fois TextButton ET ImageButton (le bouton vert peut être une image avec un texte enfant).
local function trouverBoutonSubmit()
    local codesGui = playerGui:FindFirstChild("Codes")
    if not codesGui then
        warn("[AutoCopier] playerGui.Codes introuvable (la fenêtre Codes n'a jamais été créée)")
        return nil
    end

    for _, objet in ipairs(codesGui:GetDescendants()) do
        if objet:IsA("GuiButton") then
            local texteAffiche = objet:IsA("TextButton") and objet.Text or ""
            local indice = objet.Name .. " " .. texteAffiche
            if indice:lower():find("submit") then
                return objet
            end
        end
    end

    warn("[AutoCopier] Aucun bouton contenant 'submit' trouvé sous playerGui.Codes")
    return nil
end

-- Déclenche le clic du bouton Submit sans intervention de la souris (via getconnections, comme un vrai clic).
local function soumettreCode()
    local bouton = trouverBoutonSubmit()
    if not bouton then return end

    if not getconnections then
        warn("[AutoCopier] getconnections n'existe pas dans cet executor, impossible de cliquer Submit automatiquement")
        return
    end

    local ok, connexionsBouton = pcall(getconnections, bouton.Activated)
    if not ok or not connexionsBouton or #connexionsBouton == 0 then
        ok, connexionsBouton = pcall(getconnections, bouton.MouseButton1Click)
    end

    if ok and connexionsBouton and #connexionsBouton > 0 then
        for _, conn in ipairs(connexionsBouton) do
            conn:Fire()
        end
    else
        warn("[AutoCopier] Bouton Submit trouvé (" .. bouton:GetFullName() .. ") mais aucune connexion à déclencher")
    end
end

ecrireTexte = function(texte)
    if enEcriture or texte == "" then return end
    enEcriture = true

    local boiteCode = trouverBoiteCode()
    if boiteCode then
        boiteCode:CaptureFocus()
        boiteCode.Text = (boiteCode.Text or "") .. texte

        compteurDepuisSoumission = compteurDepuisSoumission + 1
        if compteurDepuisSoumission >= seuilSoumission then
            soumettreCode()
            compteurDepuisSoumission = 0
        end
    else
        -- Repli : si la fenêtre Codes n'est pas ouverte, on écrit dans la textbox actuellement focus
        local cibleEcriture = UserInputService:GetFocusedTextBox()
        if cibleEcriture then
            cibleEcriture.Text = cibleEcriture.Text .. texte
        end
    end

    pcall(function()
        if setclipboard then setclipboard(texte) end
    end)

    enEcriture = false
end

local function copierEtEcrire(texte)
    if not autoMode or texte == "" then return end
    ecrireTexte(texte)
    ajouterHistorique(texte)
end

local function brancherDetecteur(objet)
    if objet:IsA("TextLabel") or objet:IsA("TextBox") then
        local connection = objet:GetPropertyChangedSignal("Text"):Connect(function()
            copierEtEcrire(objet.Text)
        end)
        table.insert(connexions, connection)

        if objet.Text ~= "" then
            copierEtEcrire(objet.Text)
        end
    end
end

for _, enfant in ipairs(topNotifContainer:GetDescendants()) do
    brancherDetecteur(enfant)
end
brancherDetecteur(topNotifContainer)

local childConnection = topNotifContainer.DescendantAdded:Connect(function(nouveauDescendant)
    brancherDetecteur(nouveauDescendant)
end)
table.insert(connexions, childConnection)

-- ==========================================
-- INTERRUPTEUR (TOUCHE REBINDABLE) + REBIND DEPUIS L'UI
-- ==========================================
local enAttenteTouche = false

keybindButton.MouseButton1Click:Connect(function()
    enAttenteTouche = true
    keybindButton.Text = "..."
end)

UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
    if not scriptActive then return end

    if enAttenteTouche then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            toggleKey = input.KeyCode
            keybindButton.Text = toggleKey.Name
            enAttenteTouche = false
            updateInterface(autoMode)
        end
        return
    end

    if gameProcessedEvent then return end

    if input.KeyCode == toggleKey then
        autoMode = not autoMode
        updateInterface(autoMode)

        if autoMode then
            for _, enfant in ipairs(topNotifContainer:GetDescendants()) do
                if (enfant:IsA("TextLabel") or enfant:IsA("TextBox")) and enfant.Text ~= "" then
                    copierEtEcrire(enfant.Text)
                    break
                end
            end
        end
    end
end)

