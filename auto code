local function creerBoutonIcone(texte, offsetX, couleur)
    local bouton = Instance.new("TextButton")
    bouton.Size = UDim2.new(0, 28, 0, 28)
    bouton.Position = UDim2.new(1, offsetX, 0, 18)
    bouton.BackgroundColor3 = couleur
    bouton.BackgroundTransparency = 0.8
    bouton.TextColor3 = Color3.fromRGB(255, 255, 255)
    bouton.TextSize = 14
    bouton.Font = Enum.Font.GothamBold
    bouton.Text = texte
    bouton.AutoButtonColor = false
    bouton.Parent = mainFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = bouton

    bouton.MouseEnter:Connect(function()
        TweenService:Create(bouton, TweenInfo.new(0.2), {BackgroundTransparency = 0.2}):Play()
    end)
    bouton.MouseLeave:Connect(function()
        TweenService:Create(bouton, TweenInfo.new(0.2), {BackgroundTransparency = 0.8}):Play()
    end)

    return bouton
end

