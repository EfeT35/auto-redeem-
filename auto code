    viderHistoriqueUI()

    if #historique == 0 then
        local vide = Instance.new("TextLabel")
        vide.Size = UDim2.new(1, 0, 0, 28)
        vide.BackgroundTransparency = 1
        vide.TextColor3 = Color3.fromRGB(120, 120, 120)
        vide.TextSize = 13
        vide.Font = Enum.Font.Gotham
        vide.Text = "Aucun texte détecté pour le moment."
        vide.Parent = historyFrame
        return
    end

    for i, texte in ipairs(historique) do
        local entree = Instance.new("TextButton")
        entree.Size = UDim2.new(1, 0, 0, 28)
        entree.LayoutOrder = i
        entree.BackgroundColor3 = Color3.fromRGB(0, 180, 255)
        entree.BackgroundTransparency = 0.88
        entree.BorderSizePixel = 0
        entree.TextColor3 = Color3.fromRGB(0, 220, 255)
        entree.TextSize = 13
        entree.Font = Enum.Font.Gotham
        entree.TextXAlignment = Enum.TextXAlignment.Left
        entree.TextTruncate = Enum.TextTruncate.AtEnd
        entree.Text = "  " .. texte
        entree.Parent = historyFrame

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = entree

        entree.MouseButton1Click:Connect(function()
            ecrireBrut(texte)
            TweenService:Create(entree, TweenInfo.new(0.15), {BackgroundTransparency = 0.4}):Play()
            task.wait(0.15)
            TweenService:Create(entree, TweenInfo.new(0.3), {BackgroundTransparency = 0.88}):Play()
        end)
    end
end

local function ajouterHistorique(texte)
    if historique[1] == texte then return end -- évite les doublons consécutifs

    table.insert(historique, 1, texte)
    while #historique > MAX_HISTORIQUE do
        table.remove(historique)
    end

    if historiqueOuvert then
        rafraichirHistoriqueUI()
    end
end

